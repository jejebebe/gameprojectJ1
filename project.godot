; Engine configuration file.
; run/main_scene is intentionally unset: /dev-story or the developer sets it
; once the first scene exists.

config_version=5

[application]

config/name="Claude-Code-Game-Studios"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
